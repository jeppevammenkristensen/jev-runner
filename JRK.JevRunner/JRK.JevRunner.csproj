<Project Sdk="Microsoft.NET.Sdk">
  <!-- VersionPrefix and VersionSuffix is controlled in the Directory.Build.Props file -->
  
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JRK.JevRunner</RootNamespace>
    <PackageId>JRK.JevRunner</PackageId>        
    <Title>JRK JevRunner</Title>
    <Authors>Jeppe Roi Kristensen</Authors>
    <Description>.NET client for Jev and the TypeSafe System One API that supports an approach using source generators.</Description>
    <PackageTags>jev;typesafe;ai;system-one;api-client;dotnet;source-generators</PackageTags>
    <PackageProjectUrl>https://github.com/jeppevammenkristensen/all</PackageProjectUrl>
    <PackageReleaseNotes>0.7.1: Usage analyzers and code fixes
- Bundle JEV100 and JEV101 usage diagnostics with code fixes for lost backtick quoting and redundant explicit backticks.
- Escape.Interpolated preserves arguments while returning a string. Its code fix simplifies qualification where safe and avoids shadowed local names.
- Usage diagnostics recognize marker interfaces inherited through generic class constraints and chained type parameters.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jeppevammenkristensen/all</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Runner-Icon.png</PackageIcon>   
    <IsPackable>true</IsPackable>
    
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JRK.JevRunner.Tests" />
    <ProjectReference Include="..\JRK.JevRunner.Analyzers\JRK.JevRunner.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\JRK.JevRunner.Analyzers.CodeFixes\JRK.JevRunner.Analyzers.CodeFixes.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Update="assets\Runner-Icon.png" Pack="true" PackagePath="Runner-Icon.png" />
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"  PrivateAssets="all" />
      <PackageReference Include="TruePath.TestableIO.System.IO" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

  <!-- Resolve compile-time tooling output paths, including custom output configurations.
       The project reference builds it normally; packing without a build requires existing output. -->
  <Target Name="IncludeCompileTimeToolsInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators.csproj;..\JRK.JevRunner.Analyzers\JRK.JevRunner.Analyzers.csproj;..\JRK.JevRunner.Analyzers.CodeFixes\JRK.JevRunner.Analyzers.CodeFixes.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CompileTimePackageOutput" />
    </MSBuild>
    <Error Condition="!Exists('%(_CompileTimePackageOutput.Identity)')"
           Text="Build JRK.JevRunner before packing with --no-build: compile-time tooling output is missing." />
    <ItemGroup>
      <None Include="@(_CompileTimePackageOutput)" Pack="true" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
