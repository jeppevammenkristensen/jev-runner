<Project Sdk="Microsoft.NET.Sdk">
  <!-- VersionPrefix and VersionSuffix is controlled in the Directory.Build.Props file -->
  
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JRK.JevRunner</RootNamespace>
    <PackageId>JRK.JevRunner</PackageId>        
    <Title>JRK JevRunner</Title>
    <Authors>Jeppe Roi Kristensen</Authors>
    <Description>.NET client for Jev and the TypeSafe System One API that supports an approach using source generators.</Description>
    <PackageTags>jev;typesafe;ai;system-one;api-client;dotnet;source-generators</PackageTags>
    <PackageProjectUrl>https://github.com/jeppevammenkristensen/all</PackageProjectUrl>
    <PackageReleaseNotes>Usage pricing and aggregation
- Added JevPrice with decimal rates per million input and output tokens; the output rate defaults to zero.
- Added Usage.CalculateCost, Usage.Zero, Usage.Add, and IEnumerable&lt;Usage&gt;.SumUsage(). Addition and aggregation sum input and output counts independently without changing operands; an empty sequence sums to zero.

Breaking change
- Usage is now a readonly record struct instead of a record class. It has value semantics and a zero-valued default; callers relying on null or reference identity must update their code.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/jeppevammenkristensen/all</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>Runner-Icon.png</PackageIcon>   
    <IsPackable>true</IsPackable>
    
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JRK.JevRunner.Tests" />
    <ProjectReference Include="..\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Update="assets\Runner-Icon.png" Pack="true" PackagePath="Runner-Icon.png" />
  </ItemGroup>

  <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" Version="2026.2.0"  PrivateAssets="all" />
      <PackageReference Include="TruePath.TestableIO.System.IO" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\" />
  </ItemGroup>

  <!-- Resolve the generator's actual output path, including custom output configurations.
       The project reference builds it normally; packing without a build requires existing output. -->
  <Target Name="IncludeSourceGeneratorInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_SourceGeneratorPackageOutput" />
    </MSBuild>
    <Error Condition="!Exists('%(_SourceGeneratorPackageOutput.Identity)')"
           Text="Build JRK.JevRunner before packing with --no-build: source generator output is missing." />
    <ItemGroup>
      <None Include="@(_SourceGeneratorPackageOutput)" Pack="true" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
