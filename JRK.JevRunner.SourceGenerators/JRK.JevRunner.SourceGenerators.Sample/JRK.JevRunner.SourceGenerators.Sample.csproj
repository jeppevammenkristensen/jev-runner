<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>JRK.JevRunner.SourceGenerators.Sample</RootNamespace>
    </PropertyGroup>

    <PropertyGroup Condition="'$(UsePackedJevRunner)' == 'true'">
        <JevRunnerPackageVersion Condition="'$(JevRunnerPackageVersion)' == '' and '$(VersionSuffix)' == ''">$(VersionPrefix)</JevRunnerPackageVersion>
        <JevRunnerPackageVersion Condition="'$(JevRunnerPackageVersion)' == ''">$(VersionPrefix)-$(VersionSuffix)</JevRunnerPackageVersion>
        <RestoreAdditionalProjectSources>$(MSBuildThisFileDirectory)..\..\JRK.JevRunner\bin\$(Configuration);$(MSBuildThisFileDirectory)..\..\JRK.JevRunner.Analyzers\bin\$(Configuration);$(MSBuildThisFileDirectory)..\..\JRK.JevRunner.Image\bin\$(Configuration);$(RestoreAdditionalProjectSources)</RestoreAdditionalProjectSources>
        <!-- Isolate package smoke builds from cached published packages with the same version. -->
        <RestorePackagesPath>$(MSBuildThisFileDirectory)obj\package-smoke</RestorePackagesPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(UsePackedJevRunner)' != 'true'">
        <ProjectReference Include="..\..\JRK.JevRunner\JRK.JevRunner.csproj" />
        <!-- Analyzer project references are not transitive; NuGet consumers only need JRK.JevRunner. -->
        <ProjectReference Include="..\JRK.JevRunner.SourceGenerators\JRK.JevRunner.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <ItemGroup Condition="'$(UsePackedJevRunner)' == 'true'">
        <!-- No analyzer project references: NuGet must supply all compile-time tooling. -->
        <PackageReference Include="JRK.JevRunner" Version="$(JevRunnerPackageVersion)" Condition="'$(UseImageOnly)' != 'true'" />
        <PackageReference Include="JRK.JevRunner.Image" Version="$(JevRunnerPackageVersion)" Condition="'$(IncludeImagePackage)' == 'true' or '$(UseImageOnly)' == 'true'" />
        <PackageReference Include="JRK.JevRunner.Analyzers" Version="$(JevRunnerPackageVersion)" Condition="'$(IncludeStandaloneAnalyzers)' == 'true'" />
    </ItemGroup>

    <!-- Packaging regression check: core alone, Image alone, core + Image, and an explicit analyzer
         reference must all resolve exactly one copy of each tooling assembly. -->
    <Target Name="ValidatePackedJevRunnerTooling" BeforeTargets="CoreCompile" Condition="'$(UsePackedJevRunner)' == 'true'">
        <ItemGroup>
            <_JevUsageAnalyzer Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'JRK.JevRunner.Analyzers'" />
            <_JevCodeFix Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'JRK.JevRunner.Analyzers.CodeFixes'" />
            <_JevGenerator Include="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'JRK.JevRunner.SourceGenerators'" />
        </ItemGroup>
        <Error Condition="'@(_JevUsageAnalyzer->Count())' != '1'" Text="Expected one JevRunner usage analyzer; found @(_JevUsageAnalyzer->Count()): @(_JevUsageAnalyzer)" />
        <Error Condition="'@(_JevCodeFix->Count())' != '1'" Text="Expected one JevRunner code-fix assembly; found @(_JevCodeFix->Count()): @(_JevCodeFix)" />
        <Error Condition="'@(_JevGenerator->Count())' != '1'" Text="Expected one JevRunner source generator; found @(_JevGenerator->Count()): @(_JevGenerator)" />
        <Error Condition="'%(_JevUsageAnalyzer.NuGetPackageId)' != 'JRK.JevRunner.Analyzers'" Text="The usage analyzer must come from the analyzer package, not an embedded core/Image copy." />
        <Error Condition="'%(_JevCodeFix.NuGetPackageId)' != 'JRK.JevRunner.Analyzers'" Text="The code fix must come from the analyzer package, not an embedded core/Image copy." />
    </Target>

</Project>
