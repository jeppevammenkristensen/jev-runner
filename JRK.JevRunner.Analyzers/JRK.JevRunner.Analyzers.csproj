<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <Description>Compile-time diagnostics for JRK.JevRunner.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>0.7.1: Backtick-aware interpolation diagnostics and code fixes
- Own the usage-analyzer and code-fix assemblies in one package, installed automatically through the JRK.JevRunner dependency.
- JEV100 detects lost automatic quoting in plain strings; its fix wraps the interpolation in Escape.Interpolated.
- JEV101 detects redundant explicit backticks in preserved interpolations; its fix removes only the adjacent pair.
- Recognize generic constraint chains and marker interfaces inherited through class constraints.
- Simplify generated helper qualification where safe while preserving correct binding when local names conflict.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../JRK.JevRunner.Analyzers.CodeFixes/JRK.JevRunner.Analyzers.CodeFixes.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="IncludeCodeFixInPackage" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="../JRK.JevRunner.Analyzers.CodeFixes/JRK.JevRunner.Analyzers.CodeFixes.csproj"
             Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CodeFixOutput" />
    </MSBuild>
    <Error Condition="!Exists('%(_CodeFixOutput.Identity)')" Text="Build the analyzer projects before packing with --no-build." />
    <ItemGroup>
      <None Include="@(_CodeFixOutput)" Pack="true" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>
</Project>
