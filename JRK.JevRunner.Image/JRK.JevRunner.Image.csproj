<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>JRK.JevRunner.Image</PackageId>
        <Title>JRK JevRunner Image</Title>
        <Authors>Jeppe Roi Kristensen</Authors>
        <Description>Optional SkiaSharp image helpers for JRK.JevRunner. Render normalized Jev bounding-box answers as customizable outlines and return PNG bytes without modifying the source image.</Description>
        <PackageTags>jev;typesafe;ai;system-one;images;bounding-box;skiasharp;dotnet</PackageTags>
        <PackageProjectUrl>https://github.com/jeppevammenkristensen/all</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jeppevammenkristensen/all</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Runner-Icon.png</PackageIcon>
        <PackageReleaseNotes>Initial optional SkiaSharp image helpers for JRK.JevRunner. BoxRenderer.DrawBox accepts a single BoxAnswer or an enumerable through the AppliedBox union and draws normalized bounding-box outlines with shared configurable color and stroke width. Supports injectable file access through TruePath and IFileSystem, validates coordinates and stroke width, preserves image dimensions, and returns PNG bytes without modifying the source. Includes Linux native assets alongside SkiaSharp's Windows and macOS assets. Targets .NET 11 and uses preview C# union support.</PackageReleaseNotes>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <None Update="README.md" Pack="true" PackagePath="\" />
      <None Include="..\LICENSE" Pack="true" PackagePath="\" />
      <None Include="..\JRK.JevRunner\assets\Runner-Icon.png" Pack="true" PackagePath="Runner-Icon.png" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp" Version="4.153.1" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
      <ProjectReference Include="..\JRK.JevRunner\JRK.JevRunner.csproj" />
    </ItemGroup>

</Project>
