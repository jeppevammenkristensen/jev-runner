<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>JRK.JevRunner.Image</PackageId>
        <Title>JRK JevRunner Image</Title>
        <Authors>Jeppe Roi Kristensen</Authors>
        <Description>Optional SkiaSharp image helpers for JRK.JevRunner. Validate image files, proportionally upscale or downscale them, and render normalized Jev bounding-box answers without modifying source files.</Description>
        <PackageTags>jev;typesafe;ai;system-one;images;bounding-box;skiasharp;dotnet</PackageTags>
        <PackageProjectUrl>https://github.com/jeppevammenkristensen/all</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jeppevammenkristensen/all</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Runner-Icon.png</PackageIcon>
        <PackageReleaseNotes>0.7.1: Usage analyzer integration
- Core usage analyzers and code fixes are available through the JRK.JevRunner NuGet dependency; they are not bundled again in the image package.
- Explicit analyzer and code-fix project references enable diagnostics during local image-library development without adding runtime dependencies.</PackageReleaseNotes>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <None Update="README.md" Pack="true" PackagePath="\" />
      <None Include="..\LICENSE" Pack="true" PackagePath="\" />
      <None Include="..\JRK.JevRunner\assets\Runner-Icon.png" Pack="true" PackagePath="Runner-Icon.png" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp" Version="4.153.1" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
      <ProjectReference Include="..\JRK.JevRunner\JRK.JevRunner.csproj" />
      <ProjectReference Include="..\JRK.JevRunner.Analyzers\JRK.JevRunner.Analyzers.csproj"
                        OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
      <ProjectReference Include="..\JRK.JevRunner.Analyzers.CodeFixes\JRK.JevRunner.Analyzers.CodeFixes.csproj"
                        ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

</Project>
