<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>JRK.JevRunner.Image</PackageId>
        <Title>JRK JevRunner Image</Title>
        <Authors>Jeppe Roi Kristensen</Authors>
        <Description>Optional SkiaSharp image helpers for JRK.JevRunner. Validate image files, proportionally upscale or downscale them, and render normalized Jev bounding-box answers without modifying source files.</Description>
        <PackageTags>jev;typesafe;ai;system-one;images;bounding-box;skiasharp;dotnet</PackageTags>
        <PackageProjectUrl>https://github.com/jeppevammenkristensen/jev-runner</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jeppevammenkristensen/jev-runner</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Runner-Icon.png</PackageIcon>
        <PackageReleaseNotes>Standalone image preparation and multipart-backed assets
- CreateAssetWithAdjustments validates an image and attempts one suggested resize, returning an AssetAndStateReference without registering it.
- Unchanged images remain file-backed; resized images become byte-backed PNG assets. Both support multipart upload through JRK.JevRunner. Keep file-backed sources available until execution completes.
- Register prepared assets manually with AddAssetStateAndReference, or expose them as generated query properties with AssetState.
- Breaking: AddImageAssetWithAutoAdjustment is now synchronous; remove await from existing calls.
- Asset.ReadAsBytes reads inline or stream-backed image contents and disposes opened streams.
- Adjusted output is not revalidated; preparation does not guarantee API acceptance or check request-wide limits.</PackageReleaseNotes>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <None Update="README.md" Pack="true" PackagePath="\" />
      <None Include="..\LICENSE" Pack="true" PackagePath="\" />
      <None Include="..\JRK.JevRunner\assets\Runner-Icon.png" Pack="true" PackagePath="Runner-Icon.png" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp" Version="4.153.1" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
      <ProjectReference Include="..\JRK.JevRunner\JRK.JevRunner.csproj" PrivateAssets="none" />
      <ProjectReference Include="..\JRK.JevRunner.Analyzers\JRK.JevRunner.Analyzers.csproj"
                        OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
      <ProjectReference Include="..\JRK.JevRunner.Analyzers.CodeFixes\JRK.JevRunner.Analyzers.CodeFixes.csproj"
                        ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>

</Project>
