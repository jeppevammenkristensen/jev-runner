<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>JRK.JevRunner.Image</PackageId>
        <Title>JRK JevRunner Image</Title>
        <Authors>Jeppe Roi Kristensen</Authors>
        <Description>Optional SkiaSharp image helpers for JRK.JevRunner. Validate image files, proportionally upscale or downscale them, and render normalized Jev bounding-box answers without modifying source files.</Description>
        <PackageTags>jev;typesafe;ai;system-one;images;bounding-box;skiasharp;dotnet</PackageTags>
        <PackageProjectUrl>https://github.com/jeppevammenkristensen/all</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jeppevammenkristensen/all</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>Runner-Icon.png</PackageIcon>
        <PackageReleaseNotes>0.7.0: Core client integration
- AddImageAssetWithAutoAdjustment now accepts StateReference for the state field name. Strings remain usable through implicit conversion, but empty names, whitespace, and backticks are rejected.
- Core request serialization now preserves derived AssetState properties alongside image asset references, including asset state items in combined JevMessage content.
- The core client now supports opt-in long context and optional strict model validation. Automatic model selection uses JevModel.Latest, including Box questions; explicit models remain unchanged and Box questions require jev-1.14.0 or later.
- Long context beyond the default 64 KB is slower and less accurate. The bundled known-model list may lag the TypeSafe API.</PackageReleaseNotes>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <None Update="README.md" Pack="true" PackagePath="\" />
      <None Include="..\LICENSE" Pack="true" PackagePath="\" />
      <None Include="..\JRK.JevRunner\assets\Runner-Icon.png" Pack="true" PackagePath="Runner-Icon.png" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp" Version="4.153.1" />
      <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
      <ProjectReference Include="..\JRK.JevRunner\JRK.JevRunner.csproj" />
    </ItemGroup>

</Project>
